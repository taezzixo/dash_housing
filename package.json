{
  "name": "dash-housing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "대한민국 청약 지도 및 개인 맞춤형 청약 매칭",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
